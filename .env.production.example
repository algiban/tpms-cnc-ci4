# TPMS CI4 - Production environment template
# Copy this file to .env on the production server and replace every CHANGE_ME value.
# Never commit the real production .env.

CI_ENVIRONMENT = production

# --------------------------------------------------------------------
# APP
# --------------------------------------------------------------------
# Example: https://tpms.example.local/
app.baseURL = 'http://CHANGE_ME/'
app.forceGlobalSecureRequests = false

# --------------------------------------------------------------------
# DATABASE
# --------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = tpms_ci4
database.default.username = tpms_app
database.default.password = 'CHANGE_ME_STRONG_DB_PASSWORD'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.pConnect = false
database.default.DBDebug = false

# --------------------------------------------------------------------
# TPMS DEVICE REGISTRATION
# --------------------------------------------------------------------
TPMS_API_KEY = 'CHANGE_ME_LONG_RANDOM_API_KEY'

# --------------------------------------------------------------------
# LOGGER / CACHE
# --------------------------------------------------------------------
# Production: warning/error and above. Increase temporarily only for troubleshooting.
logger.threshold = 4

# APCu is recommended on one PHP-FPM host. Cache.php falls back to file cache.
cache.handler = apcu
cache.backupHandler = file
cache.prefix = tpms_

# --------------------------------------------------------------------
# PHASE 0 PROFILER - OFF IN NORMAL PRODUCTION
# --------------------------------------------------------------------
TPMS_PERF_ENABLED = false
TPMS_PERF_LOG_ALL = false
TPMS_PERF_RESPONSE_HEADERS = false
TPMS_PERF_SLOW_QUERY_MS = 50
TPMS_PERF_SLOW_QUERY_LIMIT = 5
TPMS_PERF_QUERY_PATTERN_LIMIT = 8
TPMS_PERF_SLOW_REQUEST_MS = 250

# --------------------------------------------------------------------
# PHASE 2-4 RUNTIME OPTIMIZATION
# --------------------------------------------------------------------
TPMS_LOG_EVERY_LIFETIME_INCREMENT = false
TPMS_LIVENESS_TOUCH_SECONDS = 10
TPMS_MONITORING_CACHE_SECONDS = 1
TPMS_MONITORING_REFRESH_MS = 2000

# --------------------------------------------------------------------
# PHASE 6 RETENTION
# --------------------------------------------------------------------
TPMS_RETENTION_API_EVENTS_DAYS = 14
TPMS_RETENTION_LIFETIME_INCREMENT_DAYS = 30
TPMS_RETENTION_OPERATIONAL_LOGS_DAYS = 365
TPMS_RETENTION_BATCH_SIZE = 5000
